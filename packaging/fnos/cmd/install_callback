#!/bin/bash
# 安装文件落盘之后执行。
#
# 安装包本身不含 docker 镜像（保持包体很小）：这里对 ghcr.io 的各个加速源
# 测速择优，拉取与本机架构匹配的镜像并打成本地 tag；本地已有同版本镜像时
# 直接复用。之后 compose 以本地镜像启动（pull_policy=missing）。
set -u

CMD_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
. "$CMD_DIR/common"

wc_log "应用目录：${TRIM_APPDEST:-?}"
wc_log "数据目录：${TRIM_PKGVAR:-?}"

mkdir -p "${TRIM_PKGVAR:-/tmp}/data" 2>/dev/null || true
wc_log "生命周期日志：$WC_LOG"

if wc_pull_image; then
    wc_log "镜像准备完成"
else
    wc_log "【WARN】镜像暂未准备成功，启动时 compose 将再尝试联网拉取"
fi

if [ -f "$(wc_compose_file)" ]; then
    wc_log "compose 文件就绪：$(wc_compose_file)"
else
    wc_log "【ERROR】缺少 compose 文件：$(wc_compose_file)"
fi

wc_log "安装完成"
exit 0
