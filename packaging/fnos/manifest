; window-composer 飞牛 fnOS 应用清单（INI 格式）
;
; 字段含义见 https://developer.fnnas.com/docs/guide
; 注意：version 必须是 X.Y.Z 形式，且要和打包进 fpk 的 docker 镜像 tag
;       严格一致（scripts/build-package.sh 用同一个版本号做 tag），
;       否则安装后 compose 找不到本地镜像会去联网拉取而失败。

appname=window-composer
version=1.0.0
display_name=Window Composer
desc=把运行在飞牛 NAS 上的应用，以窗口形式编排并输出到 NAS 的物理显示器。<br>支持 HDMI / DisplayPort / USB-C(DP Alt Mode) / VGA / DVI 等全部显示接口，热插拔自动识别；通过浏览器远程控制面板画框布局、边缘吸附、多窗口不重叠、旋转与截图。
source=thirdparty
; 标准（联网）包内不含 docker 镜像（无任何架构相关二进制），镜像在安装时
; 按本机架构从 ghcr 多架构镜像拉取，因此声明 all —— x86 / ARM 飞牛均可安装。
; 打离线包（build-package.sh --offline）时脚本会用 --platform 按实际镜像
; 架构临时改写本字段（x86 或 arm），构建结束自动还原。
platform=all

maintainer=Misite齊
maintainer_url=https://github.com/MisiteQ

; 实测最低系统版本；低于该版本的应用中心不保证支持 docker-project 资源
os_min_version=0.9.27

; 桌面入口：app/ui/config 里注册的入口 id
desktop_uidir=ui
desktop_applaunchname=window-composer.main

; 控制面板端口（容器内 uvicorn 监听同端口）
service_port=8181
checkport=true

; 由飞牛应用中心显示启动/停止按钮（容器生命周期交给 docker-project 资源）
ctl_stop=true

; 本应用使用容器内 /data 持久化，不需要用户授权 NAS 目录
disable_authorization_path=true

changelog=1.0.0 首个版本：通用多显示接口支持（HDMI/DP/USB-C/VGA/DVI）、显示器热插拔守护、目标显示器切换、离线自包含镜像。
